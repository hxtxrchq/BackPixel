# Configuración Nginx para PixelBros Backend
# Copiar a: /etc/nginx/sites-available/pixelbros-backend

upstream pixelbros_backend {
    server 127.0.0.1:4000;
}

server {
    listen 80;
    server_name backendpixel.chiqo.site;

    # Redirigir HTTP a HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name backendpixel.chiqo.site;

    # Allow large portfolio/project uploads
    client_max_body_size 100m;

    # SSL - Usar Certbot para generar: sudo certbot certonly -d backendpixel.chiqo.site
    ssl_certificate /etc/letsencrypt/live/backendpixel.chiqo.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/backendpixel.chiqo.site/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Proxying
    location / {
        proxy_pass http://pixelbros_backend;
        proxy_http_version 1.1;
        
        # Headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # CORS pre-flight requests
    if ($request_method = 'OPTIONS') {
        return 204;
    }
}
