NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173,https://pixelbros.pe,https://www.pixelbros.pe
# Supabase (pooler recomendado para apps)
# Formato: postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=""
# Conexion directa usada por migraciones (si aplica)
DIRECT_URL=""
JWT_ACCESS_SECRET="pixelbros_access_secret_change_me_2026_secure"
JWT_REFRESH_SECRET="pixelbros_refresh_secret_change_me_2026_secure"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=pixelbros_refresh_token
REFRESH_COOKIE_SECURE=false
# Produccion entre dominios: none + true
REFRESH_COOKIE_SAMESITE=lax
